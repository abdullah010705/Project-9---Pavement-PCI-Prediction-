{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run pipeline (fast — demo settings)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PCI_SEARCH_ITER": "10" }
    },
    {
      "name": "Run pipeline (full — for reported numbers)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PCI_SEARCH_ITER": "40" }
    }
  ]
}
